# Copy to .env and fill in. NEVER commit the real .env.
# Every name here must also exist as a GitHub Actions secret for the
# scheduled pipelines to run (Settings -> Secrets and variables -> Actions).

# ---- Data source ----
SOURCE_API_BASE_URL=https://api.example.com
SOURCE_API_KEY=changeme

# ---- Hopsworks (feature store) ----
HOPSWORKS_API_KEY=changeme
HOPSWORKS_PROJECT=changeme

# ---- Experiment tracking (optional / stretch) ----
# The model registry lives in Hopsworks alongside the feature store, so there is no
# tracking server to operate. W&B is optional if richer run comparison is wanted.
WANDB_API_KEY=changeme

# ---- Google Cloud (serving + object storage) ----
GCP_PROJECT_ID=changeme
GCP_REGION=europe-west6
GCS_BUCKET=changeme
# Path to a service-account key file; the file itself is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ---- Runtime ----
LOG_LEVEL=INFO
